# Gitignore for client and server
# Node modules
client/node_modules/
server/node_modules/

# Environment files
client/.env
client/.env.*
!client/.env.example
server/.env
server/.env.*
!server/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS generated files
.DS_Store
Thumbs.db

# Build output (if any)
client/build/
server/dist/

# lock files
client/package-lock.json
server/package-lock.json